<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ORDER #1015 Part 5. The marketing agents' daily run: jobs/agents_daily.sh,
  which runs every agent due today (jobs/agent_run.js dueAgents).

  SHIPPED NOT LOADED. Loading this plist turns the agents on. They write DRAFT
  cards to the Review tab only (marketing Postgres: agent_cards, agent_runs);
  nothing is published, sent or posted. Mimi loads it with her own paste, after
  this branch is merged to main (launchd runs ~/repos/marketing-dashboard, never
  a branch).

  TIME: 06:00 CT, daily. RunAtLoad is false: loading must not fire a run.
  WHERE IT LOGS: the two paths below, red runs too.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.infinitybrain.marketing-agents</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/infinitybrain/repos/marketing-dashboard/jobs/agents_daily.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>TZ</key>
		<string>America/Chicago</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/infinitybrain/repos/marketing-dashboard</string>
	<key>RunAtLoad</key>
	<false/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/infinitybrain/Library/Logs/ihg_marketing_agents.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/infinitybrain/Library/Logs/ihg_marketing_agents.err</string>
</dict>
</plist>
