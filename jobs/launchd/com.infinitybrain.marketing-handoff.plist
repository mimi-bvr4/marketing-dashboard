<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ORDER #1658. Every 15 minutes (jobs/agents_handoff.sh): Katherine's GREEN
  Drive orders run the agent they name (kh_route.js), approved Bloggy Bob cards
  become UNPUBLISHED WordPress drafts (agent_handoff.js), and Run-now requests
  from the Agents page are picked up.

  SHIPPED NOT LOADED. Loading it lets an Approve on the Review tab create a
  WordPress DRAFT (status draft, never published) as brain@. Mimi loads it
  with her own paste, after
  this branch is merged to main (launchd runs ~/repos/marketing-dashboard, never
  a branch).

  TIME: every 900 seconds. RunAtLoad is false: loading must not fire a run.
  WHERE IT LOGS: the two paths below, red runs too.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.infinitybrain.marketing-handoff</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/infinitybrain/repos/marketing-dashboard/jobs/agents_handoff.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>TZ</key>
		<string>America/Chicago</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/infinitybrain/repos/marketing-dashboard</string>
	<key>RunAtLoad</key>
	<false/>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>StandardOutPath</key>
	<string>/Users/infinitybrain/Library/Logs/ihg_marketing_handoff.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/infinitybrain/Library/Logs/ihg_marketing_handoff.err</string>
</dict>
</plist>
