<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ORDER #3794. The Google Ads monitor: jobs/ads_monitor.sh.
  ORDER #3821 (Mimi, 11.25.2026): not hourly. "Checks Google Ads daily at
  6:15 AM, quick health check at 1:15 PM." The job picks which run it is from
  the CT hour (before noon = the daily pull, from noon on = the midday check).

  SHIPPED NOT LOADED, and its switch ships OFF. FEATURE FLAG: ADS_API_LIVE
  default OFF: it is not set below, so even a loaded job reads nothing. Turning
  it on is Mimi's: add <key>ADS_API_LIVE</key><string>on</string> here (and in
  com.infinitybrain.marketing-agents.plist, so the weekly Auditor reads the
  snapshot), after the Brain's service account can see the accounts.
  It reads Google Ads (GAQL SELECTs only) and writes DRAFT cards to Review; it
  never changes a bid, budget, ad or setting, and sends nothing.

  TIME: 06:15 and 13:15 CT (the Box's clock is CT). RunAtLoad is false:
  loading must not fire a run.
  WHERE IT LOGS: the two paths below, red runs too.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.infinitybrain.ads-monitor</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/infinitybrain/repos/marketing-dashboard/jobs/ads_monitor.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>TZ</key>
		<string>America/Chicago</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/infinitybrain/repos/marketing-dashboard</string>
	<key>RunAtLoad</key>
	<false/>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>6</integer>
			<key>Minute</key>
			<integer>15</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>15</integer>
		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>/Users/infinitybrain/Library/Logs/ihg_ads_monitor.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/infinitybrain/Library/Logs/ihg_ads_monitor.err</string>
</dict>
</plist>
